{
	"name": "craftsky-web-client",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"build": "vite build && node scripts/prepare-sentry-maps.mjs",
		"sentry:upload": "node scripts/upload-sentry-maps.mjs",
		"preview": "vite preview --host 127.0.0.1",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:app": "playwright test --config tests/playwright-authenticated.config.ts",
		"test:e2e:live": "node scripts/live-smoke.mjs",
		"lint": "svelte-kit sync && eslint . --max-warnings=0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:release": "node scripts/check.mjs"
	},
	"engines": {
		"node": ">=22.17"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "^1.64.1",
		"@sentry/vite-plugin": "11.11.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.0",
		"fake-indexeddb": "^6.2.7",
		"globals": "17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.156.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@firebase/app": "0.16.4",
		"@firebase/messaging": "0.13.3",
		"@rive-app/canvas": "2.49.3",
		"@sentry/browser": "11.10.0",
		"@zip.js/zip.js": "2.24.0",
		"buffer": "6.0.3",
		"hls.js": "^1.7.4",
		"seek-bzip": "2.0.0"
	},
	"overrides": {
		"minimatch": "^11.0.5"
	}
}
