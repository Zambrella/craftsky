APPVIEW_ORIGIN=http://127.0.0.1:8080

# Match Flutter beta by default; opt in only when paid features launch.
SUBSCRIPTIONS_ENABLED=false

# Match the native opt-in video upload release switch.
CRAFTSKY_ENABLE_VIDEO_UPLOADS=false

# Optional browser push. Public build-time Firebase web-app configuration only.
# Leave empty to hide browser push controls. Never put private service-account keys here.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_VAPID_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=

# Optional public Sentry project DSN. Reports remain off until explicit consent.
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=development
# Optional shell build variable; defaults to craftsky-web@<version>+<commit>:
# SENTRY_RELEASE=craftsky-web@1.1.1+build-id npm run build

# Opt-in live smoke test only: dedicated disposable Bluesky account, full password.
# Quote passwords containing #. Never use PUBLIC_ prefixes for credentials.
E2E_HANDLE=
E2E_PASSWORD=
