APPVIEW_ORIGIN=http://127.0.0.1:8080

# Optional browser push. Public build-time Firebase web-app configuration only.
# Leave empty to hide browser push controls. Never put private service-account keys here.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_VAPID_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=

# Optional public Sentry project DSN. Reports remain off until explicit consent.
PUBLIC_SENTRY_DSN=

# Optional public Firebase browser configuration, compiled into the client.
# Leave all empty to disable browser push. Never put service-account secrets here.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_VAPID_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=

# Optional public Sentry DSN. Consent is off by default.
PUBLIC_SENTRY_DSN=
