# Public production build inputs. Copy to .env.production.local.
# APPVIEW_ORIGIN and SUBSCRIPTIONS_ENABLED are Worker runtime settings in
# wrangler.jsonc. Do not put E2E passwords or API secrets in this profile.

# Optional browser push. Public build-time Firebase web-app configuration only.
# Leave empty to hide browser push controls. Never put private service-account keys here.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_VAPID_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=

# Optional public Sentry project DSN. Reports remain off until explicit consent.
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=production
