{
  "name": "@craftsky/instagram-importer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "generate": "node scripts/generate-lexicon-contract.mjs",
    "generate:check": "node scripts/generate-lexicon-contract.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "build": "npm run generate:check && npm run typecheck && vite build && node scripts/finalize-oauth-metadata.mjs production",
    "build:staging": "npm run generate:check && npm run typecheck && vite build --mode staging && node scripts/finalize-oauth-metadata.mjs staging",
    "build:preview": "npm run generate:check && npm run typecheck && vite build --mode preview && node scripts/finalize-oauth-metadata.mjs preview"
  },
  "dependencies": {
    "@atproto/api": "^0.20.32",
    "@atproto/common-web": "^0.5.6",
    "@atproto/oauth-client-browser": "^0.4.9",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.8",
    "@zip.js/zip.js": "^2.8.34",
    "dexie": "^4.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
