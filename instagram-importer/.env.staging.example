# Copy to .env.staging only for a dedicated, stable HTTPS staging deployment.
VITE_STAGING_ORIGIN=https://import-staging.example.org
VITE_OAUTH_CLIENT_ID=https://import-staging.example.org/oauth-client-metadata.json

# Keep false until the separate staging metadata and live test PDS are ready.
VITE_ENABLE_PDS_WRITES=false
