#!/usr/bin/env python3
"""Generate client taxonomy data from the versioned application catalog."""
import argparse
import json
from pathlib import Path

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser()
parser.add_argument('--check', action='store_true')
args = parser.parse_args()
catalog = json.loads((root / 'appview/internal/projectcatalog/catalog-v1.json').read_text())
release_phase = catalog['releasePhase']
assert release_phase in (1, 2)
ids = {entry['id'] for entry in catalog['entries']}
assert len(ids) == len(catalog['entries'])
for entry in catalog['entries']:
    assert all(parent in ids for parent in entry['parents'])
    assert 'pickerParent' not in entry or entry['pickerParent'] in ids
    assert all(craft in ids for craft in entry.get('crafts', []))
    assert entry['labels']['en']
client_entries = []
for entry in catalog['entries']:
    if entry.get('previewOnly', False):
        continue
    if 'displayLabel' in entry:
        # Keep the full name available to picker search and AppView search.
        entry = {
            **entry,
            'labels': {**entry['labels'], 'en': entry['displayLabel']},
            'aliases': [*entry['aliases'], entry['labels']['en']],
        }
    client_entries.append(entry)
project_items = catalog['projectItems']
detail_options = catalog['projectDetailOptions']
client_ids = {entry['id'] for entry in client_entries}
for craft, rows in project_items.items():
    assert craft in client_ids
    assert all(row['type'] in client_ids and set(row['subtypes']) <= client_ids for row in rows)
for values in detail_options.values():
    assert set(values) <= client_ids

def literal(value):
    return json.dumps(value, ensure_ascii=False).replace('$', r'\$')

lines = ['// Generated by scripts/project-catalog; do not edit.', '// ignore_for_file: type=lint',
         "import 'package:craftsky_app/projects/options/project_option.dart';", '',
         'abstract final class ProjectTaxonomy {',
         f"  static const version = {catalog['version']};",
         f"  static const releasePhase = {release_phase};",
         '  static const entries = <ProjectTaxonomyEntry>[']
for entry in client_entries:
    parent = entry.get('pickerParent') or next((p for p in reversed(entry['parents']) if p.startswith('social.craftsky.project.defs#')), None)
    extra = [f'{key}: {literal(entry[key])}' for key in ('group', 'profileId', 'detailsType', 'phase') if key in entry]
    if 'crafts' in entry:
        extra.append('crafts: <String>[' + ','.join(map(literal, entry['crafts'])) + ']')
    lines.append('    ProjectTaxonomyEntry(' + ', '.join([
        f"id: {literal(entry['id'])}", f"family: {literal(entry['family'])}",
        f"label: {literal(entry['labels']['en'])}",
        f"craft: {literal(entry['craft'])}" if 'craft' in entry else 'craft: null',
        f"parent: {literal(parent)}" if parent else 'parent: null',
        'aliases: <String>[' + ','.join(map(literal, entry['aliases'])) + ']',
        'parents: <String>[' + ','.join(map(literal, entry['parents'])) + ']',
        *extra,
    ]) + '),')
lines += ['  ];', '  static const projectItems = <String, List<ProjectItemChoices>>{']
for craft, choices in project_items.items():
    lines.append(f'    {literal(craft)}: <ProjectItemChoices>[')
    for choice in choices:
        subtypes = ','.join(map(literal, choice['subtypes']))
        lines.append(f"      ProjectItemChoices({literal(choice['type'])}, <String>[{subtypes}]),")
    lines.append('    ],')
lines += ['  };', '  static const projectDetailOptions = <String, List<String>>{']
for key, choices in detail_options.items():
    lines.append(f'    {literal(key)}: <String>[{",".join(map(literal, choices))}],')
lines += ['  };', '''
  static final _byId = {for (final entry in entries) entry.id.toLowerCase(): entry};

  static List<ProjectOption> _optionsForIds(Iterable<String> ids, {String? parent}) =>
      List.unmodifiable(ids.map((id) => _byId[id.toLowerCase()]!).map((entry) => ProjectOption(
        value: entry.id, label: entry.label, parentValue: parent ?? entry.parent,
        aliases: entry.aliases, group: entry.group,
      )));

  static List<ProjectOption> projectTypesFor(String craft) =>
      _optionsForIds((projectItems[craft] ?? const []).map((row) => row.type));

  static List<ProjectOption> projectSubtypesFor(String craft, String type) =>
      _optionsForIds((projectItems[craft] ?? const [])
          .where((row) => row.type == type).expand((row) => row.subtypes), parent: type);

  static List<ProjectOption> detailOptionsFor(String field) =>
      _optionsForIds(projectDetailOptions[field] ?? const []);

  static bool browseMatches(String actual, String selected) {
    final target = selected.toLowerCase();
    final seen = <String>{};
    bool matches(String id) => id == target || (seen.add(id) &&
        (_byId[id]?.parents.any((parent) => matches(parent.toLowerCase())) ?? false));
    return matches(actual.toLowerCase());
  }

  static List<ProjectOption> options(String family, {String? craft, String? parent}) =>
      List.unmodifiable(entries.where((e) => e.family == family &&
          (craft == null || (family == 'designTag' ? (e.crafts?.contains(craft) ?? true) : e.craft == craft)) &&
          (parent == null || e.parent == parent)).map((e) => ProjectOption(
        value: e.id, label: e.label, parentValue: e.parent, group: e.group,
        aliases: e.aliases,
      )));
}

class ProjectItemChoices {
  const ProjectItemChoices(this.type, this.subtypes);
  final String type;
  final List<String> subtypes;
}

class ProjectTaxonomyEntry {
  const ProjectTaxonomyEntry({required this.id, required this.family,
    required this.label, required this.craft, required this.parent,
    required this.aliases, required this.parents, this.group, this.crafts,
    this.profileId, this.detailsType, this.phase});
  final String id;
  final String family;
  final String label;
  final String? craft;
  final String? parent;
  final List<String> aliases;
  final List<String> parents;
  final String? group;
  final List<String>? crafts;
  final String? profileId;
  final String? detailsType;
  final int? phase;
}
''']

# The web composer still reads its ordered baseline for shared display fields.
# Item vocabulary comes from the project catalogue, including legacy entries.
existing_web_families = {'color', 'difficulty', 'piecingTechnique',
                         'quiltingMethod', 'status', 'yarnWeight'}
web_entries = []
for entry in client_entries:
    if entry['family'] in existing_web_families and entry.get('craft') != 'social.craftsky.feed.defs#punchNeedle':
        continue
    output = {key: entry[key] for key in ('id', 'family', 'aliases')}
    output['label'] = entry['labels']['en']
    output.update({key: entry[key] for key in ('craft', 'crafts', 'group', 'profileId', 'detailsType', 'phase') if key in entry})
    if entry['parents']:
        output['parents'] = entry['parents']
    if entry['family'] == 'craft' and entry['phase'] > release_phase:
        output['offered'] = False
    if 'pickerParent' in entry:
        output['parent'] = entry['pickerParent']
    web_entries.append(output)

for relative_path, content in [
    ('app/lib/projects/options/project_taxonomy.g.dart', '\n'.join(lines)),
    ('web-client/src/lib/features/composer/project-taxonomy.json', json.dumps(web_entries, ensure_ascii=False, indent=2) + '\n'),
    ('web-client/src/lib/features/composer/project-item-options.json',
     json.dumps({'projectItems': project_items, 'projectDetailOptions': detail_options}, ensure_ascii=False, indent=2) + '\n'),
]:
    path = root / relative_path
    if args.check:
        if not path.exists() or path.read_text() != content:
            raise SystemExit(f'{relative_path} generated data is stale; run python3 scripts/project-catalog')
    else:
        path.write_text(content)
