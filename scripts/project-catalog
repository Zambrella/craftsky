#!/usr/bin/env python3
"""Generate Flutter taxonomy data from the versioned application catalog."""
import argparse
import json
from pathlib import Path

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser()
parser.add_argument('--check', action='store_true')
args = parser.parse_args()
catalog = json.loads((root / 'appview/internal/projectcatalog/catalog-v1.json').read_text())
ids = {entry['id'] for entry in catalog['entries']}
assert len(ids) == len(catalog['entries'])
for entry in catalog['entries']:
    assert all(parent in ids for parent in entry['parents'])
    assert entry['labels']['en']

def literal(value):
    return json.dumps(value, ensure_ascii=False).replace('$', r'\$')

lines = ['// Generated by scripts/project-catalog; do not edit.', '// ignore_for_file: type=lint',
         "import 'package:craftsky_app/projects/options/project_option.dart';", '',
         'abstract final class ProjectTaxonomy {',
         f"  static const version = {catalog['version']};",
         '  static const entries = <ProjectTaxonomyEntry>[']
for entry in catalog['entries']:
    parent = next((p for p in reversed(entry['parents']) if p.startswith('social.craftsky.project.defs#')), None)
    lines.append('    ProjectTaxonomyEntry(' + ', '.join([
        f"id: {literal(entry['id'])}", f"family: {literal(entry['family'])}",
        f"label: {literal(entry['labels']['en'])}",
        f"craft: {literal(entry['craft'])}" if 'craft' in entry else 'craft: null',
        f"parent: {literal(parent)}" if parent else 'parent: null',
        'aliases: <String>[' + ','.join(map(literal, entry['aliases'])) + ']',
        'parents: <String>[' + ','.join(map(literal, entry['parents'])) + ']',
    ]) + '),')
lines += ['  ];', '''
  static List<ProjectOption> options(String family, {String? craft}) =>
      List.unmodifiable(entries.where((e) => e.family == family &&
          (craft == null || e.craft == craft)).map((e) => ProjectOption(
        value: e.id, label: e.label, parentValue: e.parent,
      )));
}

class ProjectTaxonomyEntry {
  const ProjectTaxonomyEntry({required this.id, required this.family,
    required this.label, required this.craft, required this.parent,
    required this.aliases, required this.parents});
  final String id;
  final String family;
  final String label;
  final String? craft;
  final String? parent;
  final List<String> aliases;
  final List<String> parents;
}
''']
content = '\n'.join(lines)
path = root / 'app/lib/projects/options/project_taxonomy.g.dart'
if args.check:
    if not path.exists() or path.read_text() != content:
        raise SystemExit('Project taxonomy generated data is stale; run python3 scripts/project-catalog')
else:
    path.write_text(content)
