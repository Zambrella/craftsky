#!/usr/bin/env bash
set -euo pipefail

for required_command in curl docker git go rg; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    echo "appview-check: required command is unavailable: $required_command" >&2
    exit 1
  fi
done
if ! docker compose version >/dev/null 2>&1; then
  echo "appview-check: Docker Compose v2 is required" >&2
  exit 1
fi

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
check_root=$(cd "$script_dir/.." && pwd)
appview_dir="$check_root/appview"
compose_file="$check_root/docker-compose.yml"
artifact_dir=${APPVIEW_CHECK_ARTIFACT_DIR:-}
if [[ -z "$artifact_dir" ]]; then
  artifact_dir=$(mktemp -d)
else
  mkdir -p "$artifact_dir"
  artifact_dir=$(cd "$artifact_dir" && pwd)
fi
if [[ -e "$artifact_dir/audit-evidence" ]]; then
  echo "appview-check: artifact directory already contains audit-evidence: $artifact_dir" >&2
  exit 1
fi

gate_project="craftsky_appview_check_${RANDOM}_$$"
gate_image="craftsky-appview-check:${RANDOM}-$$"
extract_container="${gate_project}_extract"
smoke_container="${gate_project}_smoke"
compose_started=false
image_built=false

cleanup() {
  local status=$?
  trap - EXIT
  set +e
  docker logs "$smoke_container" >"$artifact_dir/appview-smoke.log" 2>&1
  docker rm -f "$smoke_container" >/dev/null 2>&1
  docker rm -f "$extract_container" >/dev/null 2>&1
  if [[ "$compose_started" == "true" ]]; then
    docker compose -f "$compose_file" -p "$gate_project" logs --no-color >"$artifact_dir/compose.log" 2>&1
    docker compose -f "$compose_file" -p "$gate_project" down --volumes --remove-orphans >/dev/null 2>&1
  fi
  if [[ "$image_built" == "true" ]]; then
    docker image rm "$gate_image" >/dev/null 2>&1
  fi
  echo "appview-check artifacts: $artifact_dir"
  exit "$status"
}
trap cleanup EXIT

export GOTOOLCHAIN="go1.26.6"
actual_go_version=$(go env GOVERSION)
if [[ "$actual_go_version" != "go1.26.6" ]]; then
  echo "appview-check: Go version is $actual_go_version, want go1.26.6" >&2
  exit 1
fi
toolchain_goroot=$(go env GOROOT)

cd "$appview_dir"
go mod verify
go mod tidy -diff
unformatted=$("$toolchain_goroot/bin/gofmt" -l .)
if [[ -n "$unformatted" ]]; then
  echo "appview-check: gofmt is required for:" >&2
  echo "$unformatted" >&2
  exit 1
fi
go vet ./...

staticcheck_version=$(go run honnef.co/go/tools/cmd/staticcheck@2026.1 -version)
if [[ "$staticcheck_version" != "staticcheck 2026.1 (v0.7.0)" ]]; then
  echo "appview-check: unexpected Staticcheck identity: $staticcheck_version" >&2
  exit 1
fi
govulncheck_version=$(go run golang.org/x/vuln/cmd/govulncheck@v1.7.0 -version)
if ! printf '%s\n' "$govulncheck_version" | rg -q '^Scanner: govulncheck@v1\.7\.0$'; then
  echo "appview-check: unexpected govulncheck identity" >&2
  printf '%s\n' "$govulncheck_version" >&2
  exit 1
fi
repository_state=clean
if [[ -n $(git -C "$check_root" status --porcelain) ]]; then
  repository_state=dirty
fi
{
  printf 'repository_commit=%s\n' "$(git -C "$check_root" rev-parse HEAD)"
  printf 'repository_state=%s\n' "$repository_state"
  printf 'go=%s\n' "$actual_go_version"
  printf 'staticcheck=%s\n' "$staticcheck_version"
  printf '%s\n' "$govulncheck_version"
  docker compose version
  docker version --format 'docker_client={{.Client.Version}} docker_server={{.Server.Version}}'
} >"$artifact_dir/tool-identities.txt"

go run honnef.co/go/tools/cmd/staticcheck@2026.1 ./...
source_scan_clean=false
go run golang.org/x/vuln/cmd/govulncheck@v1.7.0 ./... 2>&1 \
  | tee "$artifact_dir/govuln-source.log"
source_scan_clean=true

export CRAFTSKY_POSTGRES_PORT=0
export CRAFTSKY_MINIO_PORT=0
export CRAFTSKY_MINIO_CONSOLE_PORT=0
export CRAFTSKY_POSTGRES_PUBLISH_HOST=127.0.0.1
export CRAFTSKY_MINIO_PUBLISH_HOST=127.0.0.1
export CRAFTSKY_APPVIEW_PUBLISH_HOST=127.0.0.1
compose_started=true
docker compose -f "$compose_file" -p "$gate_project" up -d --wait postgres minio

require_loopback_publish() {
  local service=$1
  local container_port=$2
  local address
  address=$(docker compose -f "$compose_file" -p "$gate_project" port "$service" "$container_port")
  case "$address" in
    127.0.0.1:* | \[::1\]:*) ;;
    *)
      echo "appview-check: $service port $container_port is not loopback-only: $address" >&2
      return 1
      ;;
  esac
  printf '%s\n' "$address"
}

postgres_address=$(require_loopback_publish postgres 5432)
minio_address=$(require_loopback_publish minio 9000)
require_loopback_publish minio 9001 >/dev/null
postgres_port=${postgres_address##*:}
minio_port=${minio_address##*:}
docker compose -f "$compose_file" -p "$gate_project" run --rm --no-deps minio-bootstrap

export TEST_DATABASE_URL="postgres://craftsky:dev@127.0.0.1:${postgres_port}/craftsky_dev?sslmode=disable"
export TEST_DATABASE_REQUIRED="true"
export TEST_S3_ENDPOINT="http://127.0.0.1:${minio_port}"
export TEST_S3_REGION="us-east-1"
export TEST_S3_BUCKET="private-scheduled-media"
export TEST_S3_ACCESS_KEY_ID="craftsky-minio"
export TEST_S3_SECRET_ACCESS_KEY="craftsky-minio-dev-secret"

assert_no_required_skips() {
  local evidence_file=$1
  if rg -q 'skipping real-pg test|TEST_S3_ENDPOINT is not configured' "$evidence_file"; then
    echo "appview-check: required PostgreSQL or MinIO coverage skipped" >&2
    exit 1
  fi
}

go test -count=1 -json ./... 2>&1 | tee "$artifact_dir/tests.json"
assert_no_required_skips "$artifact_dir/tests.json"
go test -count=1 -race -json ./... 2>&1 | tee "$artifact_dir/race-tests.json"
assert_no_required_skips "$artifact_dir/race-tests.json"

cd "$check_root"
docker build --pull --metadata-file "$artifact_dir/image-build-metadata.json" -t "$gate_image" appview
image_built=true
docker image inspect "$gate_image" >"$artifact_dir/image-inspect.json"
docker build \
  --target audit-evidence \
  --metadata-file "$artifact_dir/evidence-build-metadata.json" \
  --output "type=local,dest=$artifact_dir/audit-evidence" \
  appview
docker create --name "$extract_container" "$gate_image" >/dev/null
docker cp "$extract_container:/app/appview" "$artifact_dir/appview"
docker cp "$extract_container:/app/cli" "$artifact_dir/cli"
docker rm "$extract_container" >/dev/null
go version -m "$artifact_dir/appview" >"$artifact_dir/appview-build-info.txt"
go version -m "$artifact_dir/cli" >"$artifact_dir/cli-build-info.txt"
cp "$artifact_dir/audit-evidence/appview-deps.txt" "$artifact_dir/appview-deps.txt"
cp "$artifact_dir/audit-evidence/cli-deps.txt" "$artifact_dir/cli-deps.txt"

# Temporary exact-ID exception owner: AppView maintainers. Remove this branch
# when govulncheck/vulndb gains package-precise binary handling for
# GO-2026-5932. It is valid only with a clean source scan, no OpenPGP
# dependency, and zero OpenPGP symbols in the same-builder companion.
scan_release_binary() {
  local binary_name=$1
  local release_binary="$artifact_dir/$binary_name"
  local evidence_binary="$artifact_dir/audit-evidence/$binary_name"
  local dependency_evidence="$artifact_dir/audit-evidence/${binary_name}-deps.txt"
  local scan_log="$artifact_dir/govuln-${binary_name}-binary.log"
  local symbol_evidence="$artifact_dir/${binary_name}-symbols.tmp"
  local scan_status
  local tee_status
  local finding_ids
  local -a pipeline_status

  set +e
  go run golang.org/x/vuln/cmd/govulncheck@v1.7.0 \
    -mode=binary "$release_binary" 2>&1 | tee "$scan_log"
  pipeline_status=("${PIPESTATUS[@]}")
  scan_status=${pipeline_status[0]}
  tee_status=${pipeline_status[1]}
  set -e
  if [[ "$tee_status" -ne 0 ]]; then
    echo "appview-check: could not persist $binary_name binary scan evidence" >&2
    exit "$tee_status"
  fi
  if [[ "$scan_status" -eq 0 ]]; then
    return
  fi
  if [[ "$scan_status" -ne 3 ]]; then
    echo "appview-check: $binary_name binary scanner failed with exit $scan_status; only vulnerability exit 3 is eligible for the exact exception" >&2
    exit "$scan_status"
  fi

  finding_ids=$(sed -nE 's/.*(GO-[0-9]{4}-[0-9]+).*/\1/p' "$scan_log" | sort -u)
  if [[ "$finding_ids" != "GO-2026-5932" ]]; then
    echo "appview-check: $binary_name binary scan failed outside the exact GO-2026-5932 exception" >&2
    exit "$scan_status"
  fi
  if [[ "$source_scan_clean" != "true" ]]; then
    echo "appview-check: binary exception requires a clean source scan" >&2
    exit 1
  fi
  if rg -q '^golang.org/x/crypto/openpgp(/|$)' "$dependency_evidence"; then
    echo "appview-check: $binary_name links an OpenPGP package; GO-2026-5932 cannot be excepted" >&2
    exit 1
  fi
  go tool nm "$evidence_binary" >"$symbol_evidence"
  if rg -q 'golang.org/x/crypto/openpgp(/|\.)' "$symbol_evidence"; then
    echo "appview-check: $binary_name has an OpenPGP symbol; GO-2026-5932 cannot be excepted" >&2
    exit 1
  fi
  rm "$symbol_evidence"
  {
    printf 'finding=GO-2026-5932\n'
    printf 'owner=AppView maintainers\n'
    printf 'removal=govulncheck/vulndb gains package-precise binary handling\n'
    printf 'source_scan_clean=true\n'
    printf 'openpgp_dependency_matches=0\n'
    printf 'openpgp_symbol_matches=0\n'
  } >"$artifact_dir/${binary_name}-binary-exception.txt"
}

scan_release_binary appview
scan_release_binary cli

empty_migrations="$artifact_dir/empty-migrations"
mkdir -p "$empty_migrations"
set +e
docker run --rm \
  --entrypoint /app/cli \
  --volume "$empty_migrations:/app/migrations:ro" \
  "$gate_image" migrate status >"$artifact_dir/empty-migrations.log" 2>&1
empty_migrations_status=$?
set -e
if [[ "$empty_migrations_status" -eq 0 ]]; then
  echo "appview-check: empty operational migration bundle unexpectedly succeeded" >&2
  exit 1
fi
if ! rg -q 'migration directory .* is empty' "$artifact_dir/empty-migrations.log"; then
  echo "appview-check: empty migration bundle failed for an unexpected reason" >&2
  exit 1
fi

gate_network="${gate_project}_default"
container_database_url="postgres://craftsky:dev@postgres:5432/craftsky_dev?sslmode=disable"
run_release_cli() {
  docker run --rm \
    --network "$gate_network" \
    --entrypoint /app/cli \
    --env DATABASE_URL="$container_database_url" \
    --env ALLOWED_ORIGINS="*" \
    --env CRAFTSKY_DEV_DID="did:plc:jt3cxdyrhjhrkpwzdvonheax" \
    --env TAP_WS_URL="ws://tap:2480/channel" \
    --env SCHEDULED_POSTS_S3_ENDPOINT="http://minio:9000" \
    --env SCHEDULED_POSTS_S3_REGION="us-east-1" \
    --env SCHEDULED_POSTS_S3_BUCKET="private-scheduled-media" \
    --env SCHEDULED_POSTS_S3_ACCESS_KEY_ID="craftsky-minio" \
    --env SCHEDULED_POSTS_S3_SECRET_ACCESS_KEY="craftsky-minio-dev-secret" \
    "$gate_image" "$@"
}

migration_count=$(find "$appview_dir/migrations" -maxdepth 1 -type f -name '*.up.sql' | wc -l | tr -d '[:space:]')
if [[ "$migration_count" -le 0 ]]; then
  echo "appview-check: no up migrations found" >&2
  exit 1
fi
run_release_cli --env dev migrate up
first_status=$(run_release_cli --env dev migrate status)
if [[ ! "$first_status" =~ ^version=[0-9]+[[:space:]]dirty=false$ ]]; then
  echo "appview-check: first migration status is not clean: $first_status" >&2
  exit 1
fi
run_release_cli --env dev migrate down "$migration_count"
down_status=$(run_release_cli --env dev migrate status)
if [[ "$down_status" != "no migrations applied" ]]; then
  echo "appview-check: down-to-zero status is unexpected: $down_status" >&2
  exit 1
fi
run_release_cli --env dev migrate up
second_status=$(run_release_cli --env dev migrate status)
if [[ "$second_status" != "$first_status" ]]; then
  echo "appview-check: migration reapply status changed: $first_status -> $second_status" >&2
  exit 1
fi

docker run -d \
  --name "$smoke_container" \
  --network "$gate_network" \
  --publish 127.0.0.1::8080 \
  --env DATABASE_URL="$container_database_url" \
  --env ALLOWED_ORIGINS="*" \
  --env CRAFTSKY_DEV_DID="did:plc:jt3cxdyrhjhrkpwzdvonheax" \
  --env TAP_WS_URL="ws://tap:2480/channel" \
  --env OAUTH_CALLBACK_URL="http://127.0.0.1:18080/oauth/callback" \
  --env SCHEDULED_POSTS_S3_ENDPOINT="http://minio:9000" \
  --env SCHEDULED_POSTS_S3_REGION="us-east-1" \
  --env SCHEDULED_POSTS_S3_BUCKET="private-scheduled-media" \
  --env SCHEDULED_POSTS_S3_ACCESS_KEY_ID="craftsky-minio" \
  --env SCHEDULED_POSTS_S3_SECRET_ACCESS_KEY="craftsky-minio-dev-secret" \
  "$gate_image" dev >/dev/null
smoke_address=$(docker port "$smoke_container" 8080/tcp)
smoke_port=${smoke_address##*:}
smoke_ready=false
for _ in $(seq 1 30); do
  if curl -fsS \
    --header "Host: 127.0.0.1:18080" \
    "http://127.0.0.1:${smoke_port}/health" \
    >"$artifact_dir/appview-smoke-health.json"; then
    smoke_ready=true
    break
  fi
  if [[ -z $(docker ps --quiet --filter "name=^/${smoke_container}$" --filter status=running) ]]; then
    break
  fi
  sleep 1
done
if [[ "$smoke_ready" != "true" ]]; then
  echo "appview-check: release image did not pass the startup health smoke" >&2
  exit 1
fi

echo "appview-check: all release gates passed"
