#!/usr/bin/env python3
"""Verify published consent and deployed metadata against an exact release."""
import argparse
import json
import subprocess
import sys
import urllib.parse
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DID = 'did:plc:lmmx63zcns6gewgxqfdt4kof'


def read_json(url):
    request = urllib.request.Request(url, headers={'Accept': 'application/json'})
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.load(response)


def source(path, release):
    if release:
        return subprocess.run(['git', 'show', f'{release}:{path}'], cwd=ROOT,
                              check=True, capture_output=True, text=True).stdout
    return (ROOT / path).read_text()


def check(origin, release=None, publication_only=False):
    expected = json.loads(source('lexicon/social/craftsky/authFull.json', release))
    scopes = next(line.removeprefix('OAUTH_SCOPES=') for line in
                  source('appview/environments/prod.env.example', release).splitlines()
                  if line.startswith('OAUTH_SCOPES=')).split()
    if 'include:social.craftsky.authFull' not in scopes or any(
            scope.startswith('transition:') or scope.startswith('repo:*') for scope in scopes):
        raise ValueError('Release does not require granular CraftSky consent')
    identity = read_json('https://plc.directory/' + DID)
    if identity.get('id') != DID or 'at://craftsky.social' not in identity.get('alsoKnownAs', []):
        raise ValueError('Publishing identity does not match CraftSky')
    pds = next(service['serviceEndpoint'] for service in identity['service']
               if service['id'].endswith('#atproto_pds'))
    params = urllib.parse.urlencode({'repo': DID, 'collection': 'com.atproto.lexicon.schema',
                                    'rkey': expected['id']})
    published = read_json(pds + '/xrpc/com.atproto.repo.getRecord?' + params)['value']
    if published.pop('$type', None) != 'com.atproto.lexicon.schema' or published != expected:
        raise ValueError('Published permission set does not match release')
    params = urllib.parse.urlencode({'name': '_lexicon.craftsky.social', 'type': 'TXT'})
    dns_request = urllib.request.Request('https://cloudflare-dns.com/dns-query?' + params,
                                        headers={'Accept': 'application/dns-json'})
    with urllib.request.urlopen(dns_request, timeout=30) as response:
        answers = json.load(response).get('Answer', [])
    if [answer['data'].strip('"') for answer in answers if answer['type'] == 16] != ['did=' + DID]:
        raise ValueError('Permission-set DNS authority does not match CraftSky')
    if not publication_only:
        # Consumer metadata advertises the configured base plus optional chat
        # authority. Read the same embedded list from the exact release.
        advertised_scopes = set(scopes) | set(source(
            'appview/internal/auth/optional_chat_scopes.txt', release).split())
        metadata = read_json(origin.rstrip('/') + '/oauth-client-metadata.json')
        if metadata.get('client_id') != origin.rstrip('/') + '/oauth-client-metadata.json':
            raise ValueError('Deployed OAuth client ID does not match canonical metadata URL')
        granted = metadata.get('scope', '').split()
        if len(granted) != len(set(granted)) or set(granted) != advertised_scopes:
            raise ValueError('Deployed OAuth scopes do not match release')
    print('OAuth permission publication' + (' verified' if publication_only else ' and deployed metadata verified'))


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--origin', default='https://appview.craftsky.social')
    parser.add_argument('--release', help='Exact commit whose consent artifacts must match')
    parser.add_argument('--publication-only', action='store_true')
    args = parser.parse_args()
    try:
        check(args.origin, args.release, args.publication_only)
    except ValueError as failure:
        print('oauth-permissions-check:', failure, file=sys.stderr)
        sys.exit(1)
    except Exception:
        # Provider response bodies and capability URLs must not enter output.
        print('oauth-permissions-check: publication or metadata could not be verified', file=sys.stderr)
        sys.exit(1)
