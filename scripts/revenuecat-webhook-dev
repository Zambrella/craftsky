#!/usr/bin/env python3
"""Expose only RevenueCat's signed webhook to a temporary local-dev tunnel."""
import argparse
import http.client
from http.server import BaseHTTPRequestHandler, HTTPServer
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile
import threading

WEBHOOK_PATH = '/integrations/revenuecat/webhook'
BODY_LIMIT = 256 * 1024


def handler(upstream_port):
    class WebhookOnly(BaseHTTPRequestHandler):
        def log_message(self, *_args):
            pass  # Never log request headers, bodies, or URLs.

        def do_GET(self):
            self.send_error(404)

        def do_POST(self):
            if self.path != WEBHOOK_PATH:
                self.send_error(404)
                return
            lengths = self.headers.get_all('Content-Length', [])
            if self.headers.get('Transfer-Encoding') or len(lengths) != 1 or not lengths[0].isdigit():
                self.send_error(400)
                return
            size = int(lengths[0])
            if size > BODY_LIMIT:
                self.send_error(413)
                return
            names = ('Authorization', 'X-RevenueCat-Webhook-Signature')
            if any(len(self.headers.get_all(name, [])) != 1 for name in names):
                self.send_error(401)
                return
            self.connection.settimeout(10)
            upstream = http.client.HTTPConnection('127.0.0.1', upstream_port, timeout=10)
            try:
                body = self.rfile.read(size)
                if len(body) != size:
                    self.send_error(400)
                    return
                headers = {name: self.headers[name] for name in names}
                headers['Content-Type'] = 'application/json'
                # Preserve the signed bytes exactly; do not follow redirects or
                # accept an arbitrary upstream path, host or request header.
                upstream.request('POST', WEBHOOK_PATH, body, headers)
                response = upstream.getresponse()
                data = response.read(BODY_LIMIT + 1)
                if len(data) > BODY_LIMIT:
                    self.send_error(502)
                    return
                self.send_response(response.status)
                self.send_header('Content-Type', response.getheader('Content-Type', 'application/json'))
                self.send_header('Content-Length', str(len(data)))
                self.end_headers()
                self.wfile.write(data)
            except (OSError, http.client.HTTPException):
                self.send_error(502)
            finally:
                upstream.close()
    return WebhookOnly


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--upstream-port', type=int, required=True)
    parser.add_argument('--port', type=int, default=0)
    parser.add_argument('--state-file', type=Path, required=True)
    args = parser.parse_args()
    if not (1 <= args.upstream_port <= 65535 and 0 <= args.port <= 65535):
        parser.error('ports must be valid local TCP ports')
    binary = shutil.which('cloudflared')
    if not binary:
        parser.error('cloudflared must be installed for the temporary tunnel')
    if args.state_file.is_symlink():
        parser.error('state file must not be a symlink')
    server = HTTPServer(('127.0.0.1', args.port), handler(args.upstream_port))
    tunnel = subprocess.Popen([binary, 'tunnel', '--no-autoupdate', '--url',
                               f'http://127.0.0.1:{server.server_port}'],
                              stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)

    def read_tunnel():
        for line in tunnel.stderr:
            match = re.search(r'https://[a-z0-9-]+\.trycloudflare\.com', line)
            if match:
                fd, temporary = tempfile.mkstemp(dir=args.state_file.parent)
                with os.fdopen(fd, 'w') as output:
                    os.fchmod(output.fileno(), 0o600)
                    json.dump({'url': match[0] + WEBHOOK_PATH, 'proxyPort': server.server_port}, output)
                os.replace(temporary, args.state_file)
                print('Sandbox webhook tunnel ready; endpoint saved to the private state file.', flush=True)
        if tunnel.poll() is not None:
            print('Webhook tunnel stopped; restart and update the sandbox receiver URL.', flush=True)
            server.shutdown()

    threading.Thread(target=read_tunnel, daemon=True).start()
    print('Serving only the RevenueCat webhook on loopback; keep this process running.', flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
        tunnel.terminate()
        tunnel.wait(timeout=10)


if __name__ == '__main__':
    main()
