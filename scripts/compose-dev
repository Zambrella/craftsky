#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
cd "$repo_root"

git_dir=$(git rev-parse --path-format=absolute --git-dir)
git_common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
local_env="$repo_root/.env.local"

dotenv_value() {
  local key=$1
  local value=""

  if [[ -f "$local_env" ]]; then
    value=$(sed -n "s/^${key}=//p" "$local_env" | tail -n 1)
  fi

	printf '%s' "$value"
}

configured_value() {
  local key=$1

  if printenv "$key" >/dev/null 2>&1; then
    printf '%s' "${!key}"
    return
  fi
  dotenv_value "$key"
}

sanitize_compose_name() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9_-]+/-/g; s/^[^a-z0-9]+//; s/[^a-z0-9]+$//'
}

validate_port() {
  local name=$1
  local value=$2

  if [[ ! "$value" =~ ^[0-9]+$ ]] || (( 10#$value < 1 || 10#$value > 65535 )); then
    printf 'Invalid %s: expected a port from 1 to 65535, got %q\n' "$name" "$value" >&2
    exit 1
  fi
}

validate_publish_host() {
  local name=$1
  local value=$2
  local first second third fourth extra

  IFS=. read -r first second third fourth extra <<<"$value"
  if [[ -n "${extra:-}" || -z "${first:-}" || -z "${second:-}" || -z "${third:-}" || -z "${fourth:-}" ]]; then
    printf 'Invalid %s: expected an IPv4 address, got %q\n' "$name" "$value" >&2
    exit 1
  fi
  for octet in "$first" "$second" "$third" "$fourth"; do
    if [[ ${#octet} -gt 3 || ! "$octet" =~ ^[0-9]+$ ]] || (( 10#$octet < 0 || 10#$octet > 255 )); then
      printf 'Invalid %s: expected an IPv4 address, got %q\n' "$name" "$value" >&2
      exit 1
    fi
  done
}

normalized_bool() {
  local name=$1
  local value
  value=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
  case "$value" in
    "" | 0 | f | false)
      printf 'false'
      ;;
    1 | t | true)
      printf 'true'
      ;;
    *)
      printf 'Invalid %s: expected a boolean value\n' "$name" >&2
      exit 1
      ;;
  esac
}

repo_name=$(sanitize_compose_name "$(basename "$repo_root")")
if [[ -z "$repo_name" ]]; then
  repo_name=craftsky
fi

if [[ "$git_dir" == "$git_common_dir" ]]; then
  default_project_name=$repo_name
  default_postgres_port=5433
  default_appview_port=18080
  default_minio_port=19000
  default_minio_console_port=20001
else
  worktree_name=$(sanitize_compose_name "$(basename "$git_dir")")
  if [[ -z "$worktree_name" ]]; then
    worktree_name=worktree
  fi
  default_project_name="${repo_name}-${worktree_name}"

  # Stable per-checkout ports let linked worktrees run alongside the primary
  # checkout. The small collision risk can be handled with the overrides in
  # .env.local.
  checkout_checksum=$(printf '%s' "$repo_root" | cksum | awk '{print $1}')
  port_offset=$((checkout_checksum % 1000 + 1))
  default_postgres_port=$((15432 + port_offset))
  default_appview_port=$((18080 + port_offset))
  default_minio_port=$((19000 + port_offset))
  default_minio_console_port=$((20001 + port_offset))
fi

project_name=${CRAFTSKY_COMPOSE_PROJECT_NAME:-$(dotenv_value CRAFTSKY_COMPOSE_PROJECT_NAME)}
project_name=${project_name:-$default_project_name}
if [[ ! "$project_name" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
  printf 'Invalid CRAFTSKY_COMPOSE_PROJECT_NAME: got %q\n' "$project_name" >&2
  exit 1
fi

postgres_port=${CRAFTSKY_POSTGRES_PORT:-$(dotenv_value CRAFTSKY_POSTGRES_PORT)}
postgres_port=${postgres_port:-$default_postgres_port}
appview_port=${CRAFTSKY_APPVIEW_PORT:-$(dotenv_value CRAFTSKY_APPVIEW_PORT)}
appview_port=${appview_port:-$default_appview_port}
minio_port=${CRAFTSKY_MINIO_PORT:-$(dotenv_value CRAFTSKY_MINIO_PORT)}
minio_port=${minio_port:-$default_minio_port}
minio_console_port=${CRAFTSKY_MINIO_CONSOLE_PORT:-$(dotenv_value CRAFTSKY_MINIO_CONSOLE_PORT)}
minio_console_port=${minio_console_port:-$default_minio_console_port}
postgres_publish_host=${CRAFTSKY_POSTGRES_PUBLISH_HOST:-$(dotenv_value CRAFTSKY_POSTGRES_PUBLISH_HOST)}
postgres_publish_host=${postgres_publish_host:-127.0.0.1}
appview_publish_host=${CRAFTSKY_APPVIEW_PUBLISH_HOST:-$(dotenv_value CRAFTSKY_APPVIEW_PUBLISH_HOST)}
appview_publish_host=${appview_publish_host:-127.0.0.1}
minio_publish_host=${CRAFTSKY_MINIO_PUBLISH_HOST:-$(dotenv_value CRAFTSKY_MINIO_PUBLISH_HOST)}
minio_publish_host=${minio_publish_host:-127.0.0.1}
validate_port CRAFTSKY_POSTGRES_PORT "$postgres_port"
validate_port CRAFTSKY_APPVIEW_PORT "$appview_port"
validate_port CRAFTSKY_MINIO_PORT "$minio_port"
validate_port CRAFTSKY_MINIO_CONSOLE_PORT "$minio_console_port"
validate_publish_host CRAFTSKY_POSTGRES_PUBLISH_HOST "$postgres_publish_host"
validate_publish_host CRAFTSKY_APPVIEW_PUBLISH_HOST "$appview_publish_host"
validate_publish_host CRAFTSKY_MINIO_PUBLISH_HOST "$minio_publish_host"

dev_remote_access=$(normalized_bool APPVIEW_DEV_REMOTE_ACCESS "$(configured_value APPVIEW_DEV_REMOTE_ACCESS)")
dev_protected_transport=$(normalized_bool APPVIEW_DEV_PROTECTED_TRANSPORT "$(configured_value APPVIEW_DEV_PROTECTED_TRANSPORT)")
dev_auth_secret=$(configured_value APPVIEW_DEV_AUTH_SECRET)
expected_hosts=$(configured_value APPVIEW_EXPECTED_HOSTS)
if [[ "$appview_publish_host" == 127.* ]]; then
  if [[ "$dev_remote_access" == true || "$dev_protected_transport" == true || -n "$dev_auth_secret" ]]; then
    printf '%s\n' 'Remote-development authorization requires a non-loopback CRAFTSKY_APPVIEW_PUBLISH_HOST.' >&2
    exit 1
  fi
else
  if [[ "$dev_remote_access" != true ]]; then
    printf '%s\n' 'APPVIEW_DEV_REMOTE_ACCESS=true is required for a non-loopback CRAFTSKY_APPVIEW_PUBLISH_HOST.' >&2
    exit 1
  fi
  if [[ "$dev_protected_transport" != true ]]; then
    printf '%s\n' 'APPVIEW_DEV_PROTECTED_TRANSPORT=true is required for remote development.' >&2
    exit 1
  fi
  if (( ${#dev_auth_secret} < 32 )); then
    printf '%s\n' 'APPVIEW_DEV_AUTH_SECRET must contain at least 32 bytes for remote development.' >&2
    exit 1
  fi
  if [[ -z "$expected_hosts" ]]; then
    printf '%s\n' 'APPVIEW_EXPECTED_HOSTS is required for remote development.' >&2
    exit 1
  fi
fi

export CRAFTSKY_POSTGRES_PORT=$postgres_port
export CRAFTSKY_APPVIEW_PORT=$appview_port
export CRAFTSKY_MINIO_PORT=$minio_port
export CRAFTSKY_MINIO_CONSOLE_PORT=$minio_console_port
export CRAFTSKY_POSTGRES_PUBLISH_HOST=$postgres_publish_host
export CRAFTSKY_APPVIEW_PUBLISH_HOST=$appview_publish_host
export CRAFTSKY_MINIO_PUBLISH_HOST=$minio_publish_host
export APPVIEW_DEV_REMOTE_ACCESS=$dev_remote_access
export APPVIEW_DEV_PROTECTED_TRANSPORT=$dev_protected_transport
export APPVIEW_DEV_AUTH_SECRET=$dev_auth_secret
export APPVIEW_EXPECTED_HOSTS=$expected_hosts

compose=(docker compose --project-name "$project_name" -f "$repo_root/docker-compose.yml")
adc_path=""
gcloud_config_dir="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}"

# Respect an explicit ADC path first, then fall back to gcloud's standard
# developer credential location. A missing or unreadable credential is normal:
# the base Compose configuration leaves push delivery disabled.
if [[ -n "${GOOGLE_APPLICATION_CREDENTIALS:-}" && -f "$GOOGLE_APPLICATION_CREDENTIALS" && -r "$GOOGLE_APPLICATION_CREDENTIALS" ]]; then
  adc_path="$GOOGLE_APPLICATION_CREDENTIALS"
elif [[ -f "$gcloud_config_dir/application_default_credentials.json" && -r "$gcloud_config_dir/application_default_credentials.json" ]]; then
  adc_path="$gcloud_config_dir/application_default_credentials.json"
fi

if [[ -n "$adc_path" ]]; then
  export FIREBASE_ADC_PATH="$adc_path"
  compose+=(-f "$repo_root/docker-compose.push.yml")
  printf '%s\n' 'Firebase ADC found; push notifications enabled.' >&2
else
  printf '%s\n' 'Firebase ADC not found; push notifications disabled.' >&2
fi

instagram_meta_enabled=$(dotenv_value INSTAGRAM_META_ENABLED)
instagram_meta_enabled=$(printf '%s' "$instagram_meta_enabled" | tr '[:upper:]' '[:lower:]')
case "$instagram_meta_enabled" in
  1 | t | true)
    instagram_required_keys=(
      INSTAGRAM_DATA_HMAC_KEY
      INSTAGRAM_META_REPLIES_ENABLED
      INSTAGRAM_META_APP_SECRET
      INSTAGRAM_META_VERIFY_TOKEN
      INSTAGRAM_META_ACCESS_TOKEN
      INSTAGRAM_META_ACCOUNT_ID
      INSTAGRAM_META_API_VERSION
      INSTAGRAM_META_API_BASE_URL
      INSTAGRAM_META_DM_URL
    )
    instagram_missing_keys=()
    for key in "${instagram_required_keys[@]}"; do
      if [[ -z "$(dotenv_value "$key")" ]]; then
        instagram_missing_keys+=("$key")
      fi
    done

    if (( ${#instagram_missing_keys[@]} == 0 )); then
      printf '%s\n' 'Instagram Meta configuration found; Instagram verification enabled.' >&2
    else
      printf 'Instagram Meta integration enabled but configuration incomplete (missing: %s); AppView startup will fail.\n' \
        "$(IFS=,; printf '%s' "${instagram_missing_keys[*]}")" >&2
    fi
    ;;
  "" | 0 | f | false)
    printf '%s\n' 'Instagram Meta integration disabled; Instagram verification disabled.' >&2
    ;;
  *)
    printf 'Invalid INSTAGRAM_META_ENABLED value %q; AppView startup will fail.\n' \
      "$instagram_meta_enabled" >&2
    ;;
esac

printf 'CraftSky stack: project=%s appview-listener=http://%s:%s postgres=%s:%s minio=http://%s:%s minio-console=http://%s:%s\n' \
  "$project_name" "$appview_publish_host" "$appview_port" "$postgres_publish_host" "$postgres_port" \
  "$minio_publish_host" "$minio_port" "$minio_publish_host" "$minio_console_port" >&2

exec "${compose[@]}" "$@"
