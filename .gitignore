# Go
appview/admin/node_modules/
appview/admin/dist/
appview/bin/
appview/tmp/
*.test
*.out

# Env
config/*.env
.env
.env.local
.env.secrets.local
app/config/*.env
app/config/.env*
!app/config/.env*.example
!app/config/*.env.example

# Dev-only media fixtures stay local; the directory README remains tracked.
appview/devmedia/*
!appview/devmedia/README.md

# Worktrees
.worktrees/
.claude/worktrees/

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# Flutter ignores are in app/.gitignore (created by `flutter create`)
.fvm/

# Standalone Instagram importer
instagram-importer/node_modules/
instagram-importer/dist/
instagram-importer/coverage/
instagram-importer/playwright-report/
instagram-importer/test-results/
instagram-importer/.vite/
instagram-importer/.env*
!instagram-importer/.env.example
!instagram-importer/.env.*.example

# Static public-site browser tests
web/node_modules/
web/playwright-report/
web/test-results/
web/dist/
web/.site-build-*/
web/.deployments/
web/.wrangler/

# Python test/tool caches
__pycache__/
*.pyc

# Superpowers brainstorming artefacts
.superpowers/

# Sisyphus runtime files stay local; plans remain trackable.
.sisyphus/*
!.sisyphus/plans/
!.sisyphus/plans/*

# Dedicated status host local tooling
service-status/.wrangler/
service-status/.venv/

# Server-rendered web client
web-client/node_modules/
web-client/.svelte-kit/
web-client/.wrangler/
web-client/test-results/
web-client/playwright-report/
web-client/config/.env*
!web-client/config/.env*.example
# Ignore legacy local files during migration too.
web-client/.env*
!web-client/.env.example
web-client/.sentry-artifacts/
web-client/.deployments/
.wrangler/

# CraftSky in numbers standalone static site
stats/node_modules/
stats/playwright-report/
stats/test-results/
stats/.wrangler/
