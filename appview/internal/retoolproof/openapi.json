  "components": {
    "securitySchemes": {
      "operatorBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message",
          "requestId"
        ]
      },
      "Case": {
        "type": "object",
        "properties": {
          "caseReference": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "resolved"
            ]
          },
          "subjectType": {
            "type": "string"
          },
          "subjectDid": {
            "type": "string"
          },
          "reportCount": {
            "type": "integer",
            "format": "int64"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "caseReference",
          "revision",
          "state"
        ]
      },
      "Queue": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Case"
            }
          },
          "cursor": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ]
      },
      "CaseDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Case"
          },
          {
            "type": "object",
            "properties": {
              "safeSnapshot": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "did": {
                    "type": "string"
                  }
                }
              },
              "ownerDid": {
                "type": "string"
              },
              "reports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "details": {
                      "type": "string"
                    },
                    "reporterDid": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string"
                    }
                  }
                }
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "actorId": {
                      "type": "string"
                    },
                    "sourceSystem": {
                      "type": "string"
                    },
                    "revision": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "createdAt": {
                      "type": "string"
                    }
                  }
                }
              },
              "decisions": {
                "type": "array",
