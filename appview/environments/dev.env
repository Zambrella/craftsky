DATABASE_URL=postgres://craftsky:dev@localhost:5432/craftsky_dev?sslmode=disable
ALLOWED_ORIGINS=*
CRAFTSKY_DEV_DID=did:plc:jt3cxdyrhjhrkpwzdvonheax
TAP_WS_URL=ws://tap:2480/channel
TAP_ACK_TIMEOUT=10s
TAP_TERMINAL_TRANSACTION_BUDGET=1s
TAP_ACK_SAFETY_MARGIN=500ms
TAP_RECONNECT_MAX=30s
TAP_PROJECTION_POLL_INTERVAL=250ms
TAP_PROJECTION_LEASE_DURATION=30s
TAP_PROJECTION_BATCH_SIZE=32
TAP_PROJECTION_BACKOFF_MIN=1s
TAP_PROJECTION_BACKOFF_MAX=5m
TAP_REPOSITORY_POLL_INTERVAL=1s
TAP_REPOSITORY_LEASE_DURATION=45s
TAP_REPOSITORY_BATCH_SIZE=8
TAP_REPOSITORY_BACKOFF_MIN=2s
TAP_REPOSITORY_BACKOFF_MAX=5m
TAP_QUARANTINE_POLL_INTERVAL=1s
TAP_QUARANTINE_LEASE_DURATION=30s
TAP_QUARANTINE_OPERATION_TIMEOUT=10s
TAP_QUARANTINE_BATCH_SIZE=8

# Inbound HTTP admission. Forwarding headers are ignored unless the immediate
# socket peer belongs to one of these exact trusted-proxy CIDRs. Local Compose
# connects directly, so proxy trust remains empty.
HTTP_MAX_CONNECTIONS=512
HTTP_MAX_IN_FLIGHT_REQUESTS=256
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=90s
HTTP_WRITE_TIMEOUT=2m
HTTP_IDLE_TIMEOUT=1m
HTTP_MAX_HEADER_BYTES=32768
HTTP_TRUSTED_PROXY_CIDRS=
HTTP_CLIENT_IPV6_PREFIX_BITS=64
HTTP_OUTER_RATE_WINDOW=1m
HTTP_OUTER_GLOBAL_LIMIT=6000
HTTP_OUTER_CLIENT_LIMIT=600
HTTP_LIMITER_CAPACITY=4096
HTTP_LIMITER_IDLE_TTL=10m
HTTP_JSON_BODY_READ_TIMEOUT=10s
HTTP_UPLOAD_BODY_READ_TIMEOUT=1m

# scripts/compose-dev overrides this when readable local ADC is available.
# Without credentials, AppView starts normally with push delivery disabled.
PUSH_ENABLED=false
PUSH_BATCH_SIZE=100
PUSH_CONCURRENCY=4
PUSH_POLL_INTERVAL=1s
PUSH_LEASE_DURATION=1m
PUSH_SEND_TIMEOUT=10s
PUSH_FINALIZATION_MARGIN=5s

# Cross-process lifecycle/effect deadlines. Scheduled object settlement has no
# assumed finite server-side bound; cleanup retains exact-key tombstones.
OWNER_FENCE_ACQUIRE_TIMEOUT=5s
PDS_EFFECT_TIMEOUT=10s
SCHEDULED_MEDIA_PUT_TIMEOUT=30s

# Federated OAuth/PDS HTTP budgets. Values may be lowered locally but cannot
# exceed the built-in security ceilings or be disabled.
FEDERATED_HTTP_DIAL_TIMEOUT=5s
FEDERATED_HTTP_TLS_HANDSHAKE_TIMEOUT=5s
FEDERATED_HTTP_RESPONSE_HEADER_TIMEOUT=10s
FEDERATED_HTTP_EXPECT_CONTINUE_TIMEOUT=1s
FEDERATED_HTTP_IDLE_CONN_TIMEOUT=30s
FEDERATED_HTTP_MAX_RESPONSE_HEADER_BYTES=65536
FEDERATED_OAUTH_METADATA_TIMEOUT=10s
FEDERATED_OAUTH_REQUEST_TIMEOUT=15s
FEDERATED_PDS_JSON_TIMEOUT=15s
FEDERATED_PDS_UPLOAD_TIMEOUT=20s
FEDERATED_OAUTH_METADATA_RESPONSE_LIMIT_BYTES=65536
FEDERATED_OAUTH_RESPONSE_LIMIT_BYTES=262144
FEDERATED_PDS_JSON_RESPONSE_LIMIT_BYTES=4194304
FEDERATED_PDS_UPLOAD_RESPONSE_LIMIT_BYTES=262144

# Media limits. These defaults match the approved API contract.
LINK_PREVIEWS_ENABLED=true
MAX_POST_IMAGES=4
MAX_IMAGE_UPLOAD_BYTES=15728640
SCHEDULED_IMAGE_MAX_WIDTH=8192
SCHEDULED_IMAGE_MAX_HEIGHT=8192
SCHEDULED_IMAGE_MAX_PIXELS=16000000
SCHEDULED_IMAGE_MAX_ASPECT_RATIO=20
SCHEDULED_IMAGE_MAX_CONCURRENT_DECODES=1
SCHEDULED_IMAGE_ADMISSION_WAIT=250ms

# Private scheduled-media storage. Compose overrides the endpoint host for the
# AppView container; these credentials are local-development-only.
SCHEDULED_POSTS_S3_ENDPOINT=http://localhost:19000
SCHEDULED_POSTS_S3_REGION=us-east-1
SCHEDULED_POSTS_S3_BUCKET=private-scheduled-media
SCHEDULED_POSTS_S3_ACCESS_KEY_ID=craftsky-minio
SCHEDULED_POSTS_S3_SECRET_ACCESS_KEY=craftsky-minio-dev-secret

# Dev-only synthetic moderation controls.
APPVIEW_ENABLE_DEV_MODERATION=true
APPVIEW_DEV_MODERATION_TOKEN=local-dev-moderation-token

# OAuth (explicit localhost mode — public client, no client secret).
# The callback defaults to http://127.0.0.1:18080/oauth/callback; Compose
# replaces only its port for isolated worktrees.
OAUTH_SCOPES=atproto transition:generic
OAUTH_SESSION_ABSOLUTE_LIFETIME=4320h
CRAFTSKY_SESSION_INACTIVITY=720h
OAUTH_AUTH_REQUEST_EXPIRY=30m
OAUTH_PENDING_AUTH_REQUEST_CAPACITY=4096
OAUTH_AUTH_REQUEST_TERMINAL_RETENTION=24h
OAUTH_AUTH_REQUEST_SWEEP_INTERVAL=1m
OAUTH_AUTH_REQUEST_SWEEP_BATCH=100
OAUTH_REVOCATION_POLL_INTERVAL=5s
OAUTH_REVOCATION_BATCH_SIZE=20
OAUTH_REVOCATION_LEASE_DURATION=1m
OAUTH_REVOCATION_OPERATION_TIMEOUT=20s
OAUTH_REVOCATION_MAX_ATTEMPTS=5
OAUTH_REVOCATION_BACKOFF_MIN=1m
OAUTH_REVOCATION_BACKOFF_MAX=1h
OAUTH_REVOCATION_MAX_CREDENTIAL_RETENTION=24h
AUTH_AUXILIARY_CLEANUP_POLL_INTERVAL=5s
AUTH_AUXILIARY_CLEANUP_BATCH_SIZE=20
AUTH_AUXILIARY_CLEANUP_LEASE_DURATION=1m
AUTH_AUXILIARY_CLEANUP_OPERATION_TIMEOUT=20s
AUTH_AUXILIARY_CLEANUP_MAX_ATTEMPTS=5
AUTH_AUXILIARY_CLEANUP_BACKOFF_MIN=1m
AUTH_AUXILIARY_CLEANUP_BACKOFF_MAX=1h
AUTH_SESSION_EXPIRY_SWEEP_INTERVAL=1m
AUTH_SESSION_EXPIRY_SWEEP_BATCH=100
ACCOUNT_DELETION_INTENT_TTL=10m
ACCOUNT_DELETION_INTENT_SWEEP_INTERVAL=1m
ACCOUNT_DELETION_INTENT_SWEEP_BATCH=100
TERMINAL_PURGE_POLL_INTERVAL=1s
TERMINAL_PURGE_COMPONENT_LIMIT=16
TERMINAL_PURGE_ROW_BATCH_SIZE=100
TERMINAL_PURGE_LEASE_DURATION=1m
TERMINAL_PURGE_RETRY_DELAY=1s
IDENTITY_CACHE_REFRESH_POLL_INTERVAL=5m
IDENTITY_CACHE_REFRESH_BATCH_SIZE=100
IDENTITY_CACHE_REFRESH_OPERATION_TIMEOUT=10s
IDENTITY_CACHE_REFRESH_RETRY_DELAY=15m
CRAFTSKY_SESSION_ACTIVITY_WRITE_INTERVAL=5m
OAUTH_LOGIN_START_TIMEOUT=20s
OAUTH_CALLBACK_OPERATION_TIMEOUT=45s
OAUTH_SESSION_OPERATION_TIMEOUT=30s
# Device-bound, two-phase app handoff. This all-zero key is deliberately
# local-development-only; production must provide a generated secret.
OAUTH_HANDOFF_EXCHANGE_TTL=10m
OAUTH_HANDOFF_CONFIRMATION_TTL=2m
OAUTH_HANDOFF_RECEIPT_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
OAUTH_HANDOFF_RECEIPT_KEY_VERSION=1
APP_VERIFIED_LINK_ORIGIN=https://app.craftsky.social
# Enables the code-only craftsky-dev callback. Flutter must separately opt in
# with --dart-define=CRAFTSKY_DEV_OAUTH_SCHEME=true.
APPVIEW_ENABLE_DEV_OAUTH_SCHEME=true

# Observability. Hosted export is disabled unless SENTRY_DSN is set.
SENTRY_DSN=https://0db789277b730a641a533a2a0af32da9@o4511665947803648.ingest.de.sentry.io/4511665960517712
SENTRY_RELEASE=1.8.14
SENTRY_LOGS_ENABLED=true
SENTRY_TRACING_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=1
SENTRY_METRICS_ENABLED=true
SENTRY_TAP_TRACING_ENABLED=true
# Optional when Tap tracing is enabled.
SENTRY_TAP_TRACES_SAMPLE_RATE=1
# Local-only unsafe response-body logging remains disabled by default.
APPVIEW_UNSAFE_LOG_RESPONSE_BODIES=false
