# Non-secret local AppView configuration.
# Run just config-init to inherit development integration values from the primary
# checkout into ignored .env.secrets.local. Existing local values win.
# See docs/development/configuration.md for precedence and secret ownership.
#
# Copy this file to appview/config/.env.local, keep that file out of source control, and
# recreate the AppView container after changing it. Put credentials in
# .env.secrets.local (see .env.secrets.local.example), then run just config-init
# to generate missing CraftSky-owned keys. Never add empty generated-key entries.
# .env.local overrides .env.secrets.local, including explicitly empty values.

# Shared Compose ports/project overrides belong in root config/.env.local.

# RevenueCat is disabled by default. Local Test Store transactions are sandbox
# state and require a secret API v2 key plus an independently generated webhook
# Authorization value. Product and app IDs are public catalog identifiers.
#
# Smee reserializes forwarded JSON, so its local proxy cannot preserve the raw
# bytes covered by RevenueCat's HMAC. Signature verification may therefore be
# disabled only while APPVIEW_ENV=dev; AppView rejects this setting in prod and
# still requires the exact Authorization value. Use true for direct delivery and
# populate REVENUECAT_WEBHOOK_SIGNING_SECRET in .env.secrets.local.
# Forward with: smee --url <channel-url> --target http://127.0.0.1:<port>/integrations/revenuecat/webhook
REVENUECAT_ENABLED=false
REVENUECAT_ENVIRONMENT=sandbox
REVENUECAT_PROJECT_ID=proj9446d6b1
REVENUECAT_WEBHOOK_REQUIRE_SIGNATURE=false
REVENUECAT_APP_IDS=appcf59581472
REVENUECAT_PRODUCT_MAPPINGS='{"prodbf03835cbb":{"appId":"appcf59581472","tier":"plus"},"prodebc307849f":{"appId":"appcf59581472","tier":"business"}}'

# Remote-device development is an explicit AppView-only opt-in. The protected
# transport flag attests that an external HTTPS tunnel/reverse proxy or mTLS
# boundary plus firewall prevents access to the raw HTTP listener; it does not
# enable TLS in AppView itself. Generate a fresh secret with
# `openssl rand -hex 32`, store APPVIEW_DEV_AUTH_SECRET in .env.secrets.local, and keep
# the Postgres/MinIO publish hosts on 127.0.0.1.
# Set CRAFTSKY_APPVIEW_PUBLISH_HOST=192.168.1.50 in root config/.env.local.
# APPVIEW_DEV_REMOTE_ACCESS=true
# APPVIEW_DEV_PROTECTED_TRANSPORT=true
# APPVIEW_EXPECTED_HOSTS=appview-dev.craftsky.social

# Moderator routes use individually provisioned database credentials.
# MODERATION_ADMIN_ENABLED=true
# MODERATION_SOURCE_DID=did:plc:labeler

# Optional inbound HTTP admission overrides. Trust forwarding headers only from
# the immediate HTTPS tunnel/reverse-proxy CIDRs that actually connect to
# AppView. Leave this blank for direct local access; never use /0.
# HTTP_MAX_CONNECTIONS=512
# HTTP_MAX_IN_FLIGHT_REQUESTS=256
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=90s
# HTTP_WRITE_TIMEOUT=2m
# HTTP_IDLE_TIMEOUT=1m
# HTTP_MAX_HEADER_BYTES=32768
# HTTP_TRUSTED_PROXY_CIDRS=
# HTTP_CLIENT_IPV6_PREFIX_BITS=64
# HTTP_OUTER_RATE_WINDOW=1m
# HTTP_OUTER_GLOBAL_LIMIT=6000
# HTTP_OUTER_CLIENT_LIMIT=600
# HTTP_LIMITER_CAPACITY=4096
# HTTP_LIMITER_IDLE_TTL=10m
# HTTP_JSON_BODY_READ_TIMEOUT=10s
# HTTP_UPLOAD_BODY_READ_TIMEOUT=1m
# OAUTH_PENDING_AUTH_REQUEST_CAPACITY=4096
# OAUTH_AUTH_REQUEST_TERMINAL_RETENTION=24h
# OAUTH_AUTH_REQUEST_SWEEP_INTERVAL=1m
# OAUTH_AUTH_REQUEST_SWEEP_BATCH=100
# OAUTH_REVOCATION_POLL_INTERVAL=5s
# OAUTH_REVOCATION_BATCH_SIZE=20
# OAUTH_REVOCATION_LEASE_DURATION=1m
# OAUTH_REVOCATION_OPERATION_TIMEOUT=20s
# OAUTH_REVOCATION_MAX_ATTEMPTS=5
# OAUTH_REVOCATION_BACKOFF_MIN=1m
# OAUTH_REVOCATION_BACKOFF_MAX=1h
# OAUTH_REVOCATION_MAX_CREDENTIAL_RETENTION=24h
# AUTH_AUXILIARY_CLEANUP_POLL_INTERVAL=5s
# AUTH_AUXILIARY_CLEANUP_BATCH_SIZE=20
# AUTH_AUXILIARY_CLEANUP_LEASE_DURATION=1m
# AUTH_AUXILIARY_CLEANUP_OPERATION_TIMEOUT=20s
# AUTH_AUXILIARY_CLEANUP_MAX_ATTEMPTS=5
# AUTH_AUXILIARY_CLEANUP_BACKOFF_MIN=1m
# AUTH_AUXILIARY_CLEANUP_BACKOFF_MAX=1h
# AUTH_SESSION_EXPIRY_SWEEP_INTERVAL=1m
# AUTH_SESSION_EXPIRY_SWEEP_BATCH=100
# ACCOUNT_DELETION_INTENT_TTL=10m
# ACCOUNT_DELETION_INTENT_SWEEP_INTERVAL=1m
# ACCOUNT_DELETION_INTENT_SWEEP_BATCH=100
# TERMINAL_PURGE_POLL_INTERVAL=1s
# TERMINAL_PURGE_COMPONENT_LIMIT=16
# TERMINAL_PURGE_ROW_BATCH_SIZE=100
# TERMINAL_PURGE_LEASE_DURATION=1m
# TERMINAL_PURGE_RETRY_DELAY=1s
# IDENTITY_CACHE_REFRESH_POLL_INTERVAL=5m
# IDENTITY_CACHE_REFRESH_BATCH_SIZE=100
# IDENTITY_CACHE_REFRESH_OPERATION_TIMEOUT=10s
# IDENTITY_CACHE_REFRESH_RETRY_DELAY=15m

# Keep the external integration disabled until every value below is populated.
INSTAGRAM_META_ENABLED=false
# Start without automated replies while validating incoming webhooks.
INSTAGRAM_META_REPLIES_ENABLED=false
# Temporary local capability-spike diagnostic. This logs raw Instagram webhook
# bodies and is forcibly disabled in production configuration.
INSTAGRAM_UNSAFE_LOG_WEBHOOK_BODIES=false

# Numeric Instagram professional account user_id returned by GET /me.
INSTAGRAM_META_ACCOUNT_ID=

# Use the version configured for the Meta app and supported by the integration.
INSTAGRAM_META_API_VERSION=v25.0
INSTAGRAM_META_API_BASE_URL=https://graph.instagram.com
# Public Instagram URL opened when a member starts the DM challenge.
INSTAGRAM_META_DM_URL=https://www.instagram.com/craftskysocial/

# Generated chat and OAuth handoff keys live in .env.secrets.local.
CHAT_OPERATION_HMAC_KEY_VERSION=1
OAUTH_HANDOFF_RECEIPT_KEY_VERSION=1

# Credential-free local video by default. To use Bunny, select bunny and set
# its library ID/CDN hostname here and its Stream API key in .env.secrets.local.
# The CDN value must be a bare hostname ending in .b-cdn.net, without a URL path.
VIDEO_PROVIDER=bluesky
VIDEO_ENABLED=true
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_CDN_HOSTNAME=

# Safety alert emails require BREVO_API_KEY in .env.secrets.local and moderator
# routes enabled. Console links default to this checkout's loopback AppView
# address. Override independently of OAuth; HTTP is allowed only on loopback
# in development. Production requires an explicit HTTPS console origin.
SAFETY_EMAIL_ENABLED=false
# SAFETY_EMAIL_CONSOLE_ORIGIN=http://127.0.0.1:18080

# Optional backend telemetry; omit SENTRY_DSN to retain the development profile.
# SENTRY_DSN=
# SENTRY_LOGS_ENABLED=true
# SENTRY_TRACING_ENABLED=true
# SENTRY_METRICS_ENABLED=false
# SENTRY_TAP_TRACING_ENABLED=true
