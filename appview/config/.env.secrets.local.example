# Private DEVELOPMENT credentials only. Never copy production credentials here.
# Copy to appview/config/.env.secrets.local, then chmod 600 that file.
# Run just config-init after copying; it generates missing CraftSky-owned keys.
# Never put empty active entries for generated keys here: empty entries prevent
# setup from filling them. Existing keys are preserved, never automatically rotated.
# .env.local overrides this file, including empty values; avoid duplicate keys.

# Generated by just config-init: independent unpadded base64url 32-byte keys.
# CHAT_OPERATION_HMAC_KEY=
# OAUTH_HANDOFF_RECEIPT_KEY=
# Generated by just config-init: independent 32-byte key encoded as hexadecimal.
# INSTAGRAM_DATA_HMAC_KEY=

# Bunny development library read/write Stream key. Set the library ID and bare
# .b-cdn.net hostname in .env.local, and select VIDEO_PROVIDER=bunny there.
BUNNY_STREAM_API_KEY=
# Separate Bunny Core API key authorized for CDN purge; never the Stream key.
BUNNY_CDN_PURGE_API_KEY=

# Brevo transactional email key. Enable SAFETY_EMAIL_ENABLED in .env.local;
# moderator routes must also be enabled. SAFETY_EMAIL_CONSOLE_ORIGIN controls
# console links independently of OAuth and defaults to loopback in development.
BREVO_API_KEY=

# Meta app secret, developer-chosen webhook verification token, and long-lived
# Instagram User access token for the owned professional account.
# Keep INSTAGRAM_META_ENABLED=false until the complete bundle is configured.
INSTAGRAM_META_APP_SECRET=
INSTAGRAM_META_VERIFY_TOKEN=
INSTAGRAM_META_ACCESS_TOKEN=

# RevenueCat secret API v2 key and independent webhook Authorization value.
# Use sandbox configuration in .env.local. The signing secret is required when
# REVENUECAT_WEBHOOK_REQUIRE_SIGNATURE=true and the integration is enabled.
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNING_SECRET=

# Optional Stripe Managed Payments server key. Use this merchant's sandbox
# sk_test_ key for development; configure the complete checkout bundle in
# .env.local before enabling it. Never use a production key in this file.
# STRIPE_SECRET_KEY=

# Optional protected remote-device access; requires the related transport, host
# configuration in .env.local and publish host in root config/.env.local. Not inherited into worktrees.
# Generate with openssl rand -hex 32. Localhost development needs no such secret.
# APPVIEW_DEV_AUTH_SECRET=
